generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum GameMode {
  CLASSIC
  INSTANT
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET
  WIN
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GameStatus {
  WAITING
  DRAWING
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

model User {
  id          String     @id @default(uuid())
  telegramId  BigInt     @unique
  username    String?    @unique
  firstName   String?
  lastName    String?
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  wallet       Wallet?
  tickets      Ticket[]
  transactions Transaction[]

  @@index([telegramId])
  @@index([role])
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique

  playBalance   Decimal  @db.Decimal(18,2) @default(0)
  mainBalance   Decimal  @db.Decimal(18,2) @default(0)

  currency      String   @default("ETB")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KenoGame {
  id          String      @id @default(uuid())
  roundNumber Int         @unique

  mode        GameMode    @default(CLASSIC)
  status      GameStatus  @default(WAITING)

  drawNumbers Int[]

  startedAt   DateTime    @default(now())
  finishedAt  DateTime?

  tickets     Ticket[]
  fairness    FairnessRecord?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([roundNumber])
  @@index([status])
  @@index([mode])
}

model Ticket {
  id              String        @id @default(uuid())

  userId          String
  gameId          String

  mode            GameMode      @default(CLASSIC)
  selectedNumbers Int[]

  betAmount       Decimal       @db.Decimal(18,2)

  matches         Int           @default(0)

  multiplier      Decimal       @default(0) @db.Decimal(18,2)

  payout          Decimal       @default(0) @db.Decimal(18,2)

  status          TicketStatus  @default(PENDING)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  game            KenoGame      @relation(fields: [gameId], references: [id])

  @@index([userId])
  @@index([gameId])
  @@index([status])
}

model Transaction {
  id              String              @id @default(uuid())

  userId          String
  user            User                @relation(fields: [userId], references: [id])

  type            TransactionType
  status          TransactionStatus   @default(SUCCESS)

  amount          Decimal             @db.Decimal(18,2)

  balanceBefore   Decimal             @db.Decimal(18,2)
  balanceAfter    Decimal             @db.Decimal(18,2)

  reference       String?

  createdAt       DateTime            @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model FairnessRecord {
  id String @id @default(uuid())

  gameId String @unique

  serverSeed String

  serverSeedHash String

  clientSeed String

  nonce Int

  game KenoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model GameSettings {
  id                 String   @id @default("default")
  numberPoolSize     Int      @default(80)
  drawCount          Int      @default(20)
  minPick            Int      @default(1)
  maxPick            Int      @default(10)
  minBet             Decimal  @default(1) @db.Decimal(18,2)
  maxBet             Decimal  @default(10000) @db.Decimal(18,2)
  payoutTable        Json
  rtpPercentage      Decimal  @default(95.0) @db.Decimal(5,2)
  houseEdge          Decimal  @default(5.0) @db.Decimal(5,2)
  drawIntervalSec    Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}