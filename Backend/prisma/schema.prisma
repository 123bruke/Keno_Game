generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET
  WIN
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GameStatus {
  PENDING
  COMPLETED
}

model User {
  id          String   @id @default(uuid())
  telegramId  BigInt   @unique
  username    String?  @unique
  firstName   String?
  lastName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet       Wallet?
  tickets      Ticket[]
  transactions Transaction[]
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique

  playBalance   Decimal  @db.Decimal(18,2) @default(0)
  mainBalance   Decimal  @db.Decimal(18,2) @default(0)

  currency      String   @default("ETB")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KenoGame {
  id            String   @id @default(uuid())

  roundNumber   Int      @unique
  drawNumbers   Int[]

  status        GameStatus @default(PENDING)

  createdAt     DateTime @default(now())
  finishedAt    DateTime?

  tickets Ticket[]

  fairness FairnessRecord?
}

model Ticket {
  id String @id @default(uuid())

  userId String
  gameId String

  selectedNumbers Int[]

  betAmount Decimal @db.Decimal(18,2)

  matches Int?

  multiplier Decimal? @db.Decimal(10,2)

  payout Decimal? @db.Decimal(18,2)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  game KenoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Transaction {
  id String @id @default(uuid())

  userId String

  type TransactionType

  amount Decimal @db.Decimal(18,2)

  balanceBefore Decimal @db.Decimal(18,2)

  balanceAfter Decimal @db.Decimal(18,2)

  status TransactionStatus @default(SUCCESS)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FairnessRecord {
  id String @id @default(uuid())

  gameId String @unique

  serverSeed String

  serverSeedHash String

  clientSeed String

  nonce Int

  game KenoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
}